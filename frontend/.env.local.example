# ─────────────────────────────────────────────────────────────────────────────
# IntelligenceOS Frontend — Local Development Environment
#
# Copy this file to .env.local and fill in the values.
# .env.local is gitignored and never committed.
#
# In local development, the Vite dev server proxies /api → http://localhost:8000
# via vite.config.ts, so VITE_API_URL is typically left empty.
#
# For production Vercel deployment:
#   Set VITE_API_URL in the Vercel dashboard under:
#   Project → Settings → Environment Variables
#   Value: https://your-render-web-service.onrender.com
#
# IMPORTANT: Only VITE_* prefixed variables are exposed to the browser bundle.
# Never put server-side secrets here (DB passwords, service role keys, etc.)
# ─────────────────────────────────────────────────────────────────────────────

# Backend API base URL. Leave empty for local dev (Vite proxy handles it).
# Set to your Render web service URL for production.
VITE_API_URL=
