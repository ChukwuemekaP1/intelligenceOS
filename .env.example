# IntelligenceOS - Environment Configuration
# Copy this file to .env and adjust values for your environment.

# Application
ENVIRONMENT=development
DEBUG=false
PROJECT_NAME="IntelligenceOS"
API_V1_STR=/api/v1

# Security & Authentication
# WARNING: Generate a secure random key for production: openssl rand -hex 32
SECRET_KEY=change-this-in-production-use-a-strong-random-secret-key-32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database (PostgreSQL)
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=intelligenceos
POSTGRES_PASSWORD=intelligenceos_secret
POSTGRES_DB=intelligenceos
DATABASE_URL=postgresql+asyncpg://intelligenceos:intelligenceos_secret@postgres:5432/intelligenceos

# Redis Cache & Background Ingestion Queue
REDIS_URL=redis://redis:6379/0
INGESTION_QUEUE_NAME=intelligenceos:jobs:ingestion

# Object Storage (S3-Compatible / MinIO)
# Set STORAGE_BACKEND to "s3", "local", or "mock"
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=intelligenceos-sources
S3_REGION=us-east-1
LOCAL_STORAGE_DIR=./storage_data
MAX_UPLOAD_SIZE_BYTES=20971520

# Vector Storage (Qdrant)
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=intelligenceos_chunks

# LLM Provider (Gemini)
# Set LLM_PROVIDER to "gemini" or "mock" (useful for testing and offline development)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# Embedding Provider (Gemini / Mock)
# Set EMBEDDING_PROVIDER to "gemini" or "mock"
EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=768

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
