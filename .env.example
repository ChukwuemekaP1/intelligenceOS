# IntelligenceOS - Environment Configuration
# Copy this file to .env and adjust values for your environment.

# Application
ENVIRONMENT=production
DEBUG=false
PROJECT_NAME="IntelligenceOS"
API_V1_STR=/api/v1
PORT=8000
CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173

# Security & Authentication
# WARNING: Generate a secure random key for production (min 32 chars): openssl rand -hex 32
SECRET_KEY=change-this-in-production-use-a-strong-random-secret-key-32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database (Supabase PostgreSQL)
# Format: postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres

# Redis Cloud Cache & Background Ingestion Queue
# Format: redis://default:[PASSWORD]@[HOST]:[PORT]
REDIS_URL=redis://default:your-redis-password@your-redis-host:18913
REDIS_CONNECT_TIMEOUT=10.0
REDIS_SOCKET_TIMEOUT=10.0
INGESTION_QUEUE_NAME=intelligenceos:jobs:ingestion

# Object Storage (Supabase Storage)
# Set STORAGE_BACKEND to "supabase", "local", or "mock"
STORAGE_BACKEND=supabase
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=IntellegnceOS(Files)
SUPABASE_ANON_KEY=your-supabase-anon-key
LOCAL_STORAGE_DIR=./storage_data
MAX_UPLOAD_SIZE_BYTES=20971520

# Vector Storage (Qdrant Cloud)
QDRANT_URL=https://your-cluster-endpoint.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION=intelligenceos_chunks
QDRANT_TIMEOUT=15.0

# LLM Provider (Gemini)
# Set LLM_PROVIDER to "gemini" or "mock"
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# Embedding Provider (Gemini / Mock)
# Set EMBEDDING_PROVIDER to "gemini" or "mock"
EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=768

# RAG & Agent Settings
RAG_INITIAL_TOP_K=20
RAG_FINAL_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.0
RAG_ENABLE_RERANKING=true
RAG_RETRIEVAL_MODE=hybrid
RERANKER_TYPE=local

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
